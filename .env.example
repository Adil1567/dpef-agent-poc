# LLM provider to use: "groq" (free tier, default) or "openai" (paid)
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) - required if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (https://platform.openai.com/api-keys) - required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firecrawl (https://www.firecrawl.dev/app/api-keys) - required for the research tool
FIRECRAWL_API_KEY=
